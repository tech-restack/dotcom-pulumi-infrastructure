<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy into a workload repo as nuget.config.
  Source is GitHub Packages for tech-restack.

  Authenticate with a GitHub token that has read:packages. Do not put the token in this file.
  Command: dotnet nuget update source github with username and password from GITHUB_TOKEN,
  and store-password-in-clear-text.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/tech-restack/index.json" />
  </packageSources>
</configuration>
